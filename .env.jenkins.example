# Copy to .env.jenkins and adjust values:
#   cp .env.jenkins.example .env.jenkins
#
# CIRCLEGUARD_GIT_URL — clone URL Jenkins uses for the shared library AND the circle-guard-dev Pipeline job.
# MUST be the Git clone URL ending in .git — NOT the browser URL (never use .../tree/branch).
# Wrong: https://github.com/org/repo/tree/dev
# Right:  https://github.com/org/repo.git
# Use HTTPS. For a private repo, add credentials in Jenkins UI (see docs/bootstrap/README.md).
CIRCLEGUARD_GIT_URL=https://github.com/danielgrw/circle-guard-public.git

# First-login password for user "admin"
JENKINS_ADMIN_PASSWORD=changeme

# Base URL for runE2ETests() stub (update after you know gateway NodePort / ingress)
DEV_BASE_URL=http://127.0.0.1:8087

# Optional: full path to docker CLI on the Jenkins controller (buildAndPush uses this; default /usr/bin/docker via CasC)
# DOCKER_BIN=/usr/bin/docker

# Registry host:port for docker build/push (DooD = host daemon; must be reachable from the host, not compose DNS).
# Default localhost:5000 (see docker-compose.jenkins.yml port mapping + kind local registry). Rare override: CI_REGISTRY_HOST=docker-registry:5000
# CI_REGISTRY_HOST=localhost:5000

# --- Git branches (not the same as dev / stage / master *deploy* targets) ---
# Those K8s/env targets come from each Jenkinsfile (e.g. ENV_LABEL, namespace in Jenkinsfile.dev).
# Here you only choose which *Git ref* Jenkins clones for the job + shared library.
#
# CIRCLEGUARD_GIT_BRANCH — branch spec for the auto-seeded job "circle-guard-dev" (see jenkins/docker/casc).
#   Put the branch where integrated dev work lives in *your* flow, e.g. develop, main, or master.
#   Example: */develop  or  */main  or  */master  (must exist on the remote).
CIRCLEGUARD_GIT_BRANCH=*/dev
#
# CIRCLEGUARD_LIB_BRANCH — branch Jenkins uses to load @Library('circleguard-shared-library') (jenkins/vars).
#   Usually the same default branch you trust for pipeline steps (main or master), not "staging" unless
#   you only maintain pipeline code there. If you add separate jobs for stage/prod later, each job can
#   use its own branch/Jenkinsfile in CasC; one .env cannot drive three different jobs with three values.
CIRCLEGUARD_LIB_BRANCH=dev
