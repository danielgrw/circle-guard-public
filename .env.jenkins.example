# Copy to .env.jenkins and adjust values:
#   cp .env.jenkins.example .env.jenkins
#
# CIRCLEGUARD_GIT_URL — clone URL Jenkins uses for the shared library AND the circle-guard-dev Pipeline job.
# Use HTTPS. For a private repo, add credentials in Jenkins UI and set CIRCLEGUARD_GIT_CREDENTIALS_ID (see docs).
CIRCLEGUARD_GIT_URL=https://github.com/YOUR_ORG/circle-guard-public.git

# First-login password for user "admin"
JENKINS_ADMIN_PASSWORD=changeme

# Base URL for runE2ETests() stub (update after you know gateway NodePort / ingress)
DEV_BASE_URL=http://127.0.0.1:8087

# Branch for the seeded Pipeline job (Job DSL branch spec, e.g. */main or */master)
CIRCLEGUARD_GIT_BRANCH=*/main

# Branch the Global Pipeline Library checks out (must exist on the remote)
CIRCLEGUARD_LIB_BRANCH=main
